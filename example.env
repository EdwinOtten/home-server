GITHUB_READ_TOKEN=xxx
REPO_URL=https://github.com/EdwinOtten/home-server.git

# Optional repository polling overrides (doco-cd)
# For local testing using a mounted file-based repo:
# REPO_URL=file:///repo
# REPO_REF=main
# POLL_INTERVAL=60
# RUN_ONCE=false
# REPO_DIR=.

# Optional NFS server address override for local testing (defaults to production 192.168.1.111)
# NFS_SERVER_ADDR=192.168.1.111
